# Configuración de Proveedor LLM: 'gemini' o 'groq'
LLM_PROVIDER=gemini

# Claves de API (configura al menos una según el proveedor que vayas a usar)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Alternativa:
# GROQ_API_KEY=tu_api_key_de_groq_aqui

# Modelos opcionales (defaults: gemini-2.5-flash / llama-3.3-70b-versatile)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
