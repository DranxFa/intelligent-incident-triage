# Configuración de Proveedor LLM: 'gemini' o 'groq'
LLM_PROVIDER=gemini

# Claves de API (configura al menos una según el proveedor que vayas a usar)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Alternativa:
# GROQ_API_KEY=tu_api_key_de_groq_aqui

# Modelos opcionales (defaults: gemini-2.5-flash / llama-3.3-70b-versatile)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Webhooks de Notificación para Incidentes Críticos (P1 - Ruta A)
# Puedes configurar uno de los siguientes:
# 1. Discord Webhook:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# 2. Telegram Bot:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-100123456789
# 3. Correo / Webhook Genérico (ej. Zapier, Make, servicio de correo):
# EMAIL_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
